#!/usr/bin/env python3
"""DS5Tee: tray icon + settings window for ds5bridge, per controller: speaker, haptics, rumble (each with a
short preview played by the bridge), trigger strength/mode per side, gyro on the right stick, lightbar colour (fixed, by battery level or from the game), player LED,
auto-disconnect time (read by bt-idle-disconnect.py) and a disconnect button, plus whether KDE uses
DualSense touchpads as a mouse.
Writes ~/.config/ds5bridge.json ({"default": {...}, "pads": {MAC: {...}}, "touchpad_mouse": bool});
the bridge applies it within 0.3 s. Battery/connection come from /run/ds5bridge/status.json."""
import json, os, subprocess, sys, time
from PySide6.QtCore import QTimer, Qt
from PySide6.QtGui import QAction, QActionGroup, QColor, QIcon
from PySide6.QtWidgets import (QApplication, QCheckBox, QColorDialog, QComboBox, QDialog, QFormLayout,
                               QHBoxLayout, QLabel, QMenu, QPushButton, QSlider, QSystemTrayIcon)

CONFIG = os.path.expanduser("~/.config/ds5bridge.json")
STATUS = "/run/ds5bridge/status.json"
# German UI on a German system, English otherwise.
DE = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").startswith("de")


def t(de, en):
    return de if DE else en

DEFAULTS = {"speaker": 50, "haptics": 100, "rumble": 100, "trigger_strength_l": 100, "trigger_strength_r": 100,
            "trigger_mode_l": "game", "trigger_mode_r": "game", "color": "", "player": 0, "idle_minutes": 15,
            "gyro": "off", "gyro_sensitivity": 37,
            "gyro_invert_x": False, "gyro_invert_y": False}
MODES = {"game": t("Vom Spiel", "From game"), "off": t("Aus", "Off"), "resistance": t("Widerstand", "Resistance"),
         "weapon": t("Waffe (Druckpunkt)", "Weapon (trigger point)"), "vibration": "Vibration"}
PLAYERS = {0: t("Vom Spiel", "From game"), 1: "1", 2: "2", 3: "3", 4: "4"}
GYRO = {"off": t("Aus", "Off"), "aim": t("Beim Zielen (L2 gedrückt)", "While aiming (L2 held)"), "always": t("Immer", "Always")}
BRIDGE_LABEL = t("Kabel-Emulation (echten Controller verstecken)", "Wired emulation (hide the real controller)")
BRIDGE_TIP = t("Aus: Der Controller ist ein normaler Bluetooth-Controller – ohne Haptik, Lautsprecher und adaptive "
               "Trigger in Spielen. Nach dem Umschalten das Spiel neu starten.",
               "Off: the controller is a plain Bluetooth controller – no haptics, speaker or adaptive triggers in "
               "games. Restart the game after switching.")
IDLE = {0: t("Nie", "Never"), 5: "5 min", 10: "10 min", 15: "15 min", 30: "30 min", 60: "60 min"}
PREVIEW = ("speaker", "haptics", "rumble")  # sliders that play a sample in the controller
DEFAULT_KEY = ""  # the "default" section: used by controllers without own settings
NAMES = {}  # KWin input device path -> name


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


ASM_OVERRIDES = os.path.expanduser("~/.config/arctis_manager/routing_overrides.json")
WINE_BINARIES = {"wine64-preloader", "wine-preloader", "wine", "wine64"}


def keep_haptics_on_pad():
    """Arctis Sound Manager moves every Wine stream onto the headset, the pad's 4-channel haptics/speaker
    stream too (the pad's audio endpoint has 4 channels). Pin those apps to the DualSense sink in ASM's own
    override list, which its router re-reads every few seconds."""
    if not os.path.exists(ASM_OVERRIDES):
        return
    try:
        graph = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return
    props = {o["id"]: o.get("info", {}).get("props", {}) for o in graph if o.get("type") == "PipeWire:Interface:Node"}
    # ponytail: first DualSense sink; with two pads in two games each stream could need its own pad
    sink = next((p["node.name"] for p in props.values()
                 if p.get("media.class") == "Audio/Sink" and "DualSense" in p.get("node.name", "")), None)
    if not sink:
        return
    channels = {}
    for o in graph:
        info = o.get("info", {})
        if o.get("type") == "PipeWire:Interface:Port" and info.get("direction") == "output":
            channels.setdefault(info["props"].get("node.id"), []).append(info["props"].get("audio.channel"))
    # Wine opens the pad either via winepulse (FL FR RL RR, named after the .exe) or via its ALSA
    # driver ("PipeWire ALSA [wine64-preloader]", AUX0-3); game audio itself is stereo/5.1/7.1.
    apps = {p.get("application.name") for i, p in props.items()
            if p.get("media.class") == "Stream/Output/Audio" and len(channels.get(i, [])) == 4
            and (p.get("application.process.binary") in WINE_BINARIES or "wine" in p.get("application.name", ""))}
    overrides = load(ASM_OVERRIDES, {})
    if all(overrides.get(a) == sink for a in apps):
        return
    overrides.update({a: sink for a in apps if a})
    with open(ASM_OVERRIDES + ".tmp", "w") as f:
        json.dump(overrides, f, indent=2)
    os.replace(ASM_OVERRIDES + ".tmp", ASM_OVERRIDES)


def set_touchpad_mouse(enabled):
    """Enable/disable DualSense touchpads as desktop pointer in KWin (games still read them)."""
    kwin = ["busctl", "--user"]
    tree = subprocess.run(kwin + ["tree", "org.kde.KWin", "--list"], capture_output=True, text=True).stdout
    paths = [l for l in tree.split() if "/InputDevice/event" in l]
    for gone in set(NAMES) - set(paths):  # removed devices; their event numbers get reused
        del NAMES[gone]
    for path in paths:
        if path not in NAMES:
            NAMES[path] = subprocess.run(kwin + ["get-property", "org.kde.KWin", path, "org.kde.KWin.InputDevice",
                                                 "name"], capture_output=True, text=True).stdout
        if "DualSense" in NAMES[path] and "Touchpad" in NAMES[path]:
            subprocess.run(kwin + ["set-property", "org.kde.KWin", path, "org.kde.KWin.InputDevice", "enabled",
                                   "b", "true" if enabled else "false"], capture_output=True)


def pad_label(p):
    bat = f"{p['battery']} %" if p.get("battery") is not None else "?"
    return f"DualSense …{p['mac'][-5:]} – {t('Akku', 'battery')} {bat}{' ⚡' if p.get('charging') else ''}"


class Settings(QDialog):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.setWindowTitle("DS5Tee")
        self.setWindowIcon(app.icon)
        form = QFormLayout(self)
        self.target = QComboBox()
        self.target.activated.connect(lambda _: self.refresh())
        form.addRow("Controller", self.target)
        self.sliders, self.combos, self.checks = {}, {}, {}
        rows = ((t("Lautsprecher", "Speaker"), None, "speaker", 100), (t("Haptik", "Haptics"), None, "haptics", 200),
                (t("Vibration", "Rumble"), None, "rumble", 100),
                ("Trigger L", ("trigger_mode_l", MODES), "trigger_strength_l", 100),
                ("Trigger R", ("trigger_mode_r", MODES), "trigger_strength_r", 100),
                (t("Gyro → rechter Stick", "Gyro → right stick"), ("gyro", GYRO), "gyro_sensitivity", 300),
                ("Controller-ID", ("player", PLAYERS), None, 0), (t("Auto-Trennen", "Auto-disconnect"), ("idle_minutes", IDLE), None, 0))
        for label, combo_def, key, top in rows:  # mode combo and its strength slider share one row
            row = QHBoxLayout()
            if combo_def:
                ckey, choices = combo_def
                combo = QComboBox()
                for k, v in choices.items():
                    combo.addItem(v, k)
                combo.activated.connect(lambda i, k=ckey, c=combo: self.set(k, c.itemData(i)))
                row.addWidget(combo)
                self.combos[ckey] = combo
            if key:
                slider = QSlider(Qt.Horizontal)
                slider.setRange(0, top)
                slider.setMinimumWidth(160)
                value = QLabel()
                value.setMinimumWidth(40)
                slider.valueChanged.connect(lambda v, k=key, l=value, sl=slider: (l.setText(f"{v} %"), self.set(k, v, sl)))
                if key in PREVIEW:  # sample only when the drag ends, not while holding the handle
                    slider.sliderReleased.connect(lambda k=key: self.app.preview_soon(k, 200))
                row.addWidget(slider, 1)
                row.addWidget(value)
                self.sliders[key] = (slider, value)
            form.addRow(label, row)
            if key == "gyro_sensitivity":
                row = QHBoxLayout()
                for k, text in (("gyro_invert_x", "Horizontal"), ("gyro_invert_y", t("Vertikal", "Vertical"))):
                    check = QCheckBox(text)
                    check.toggled.connect(lambda on, k=k: self.set(k, on))
                    row.addWidget(check)
                    self.checks[k] = check
                row.addStretch()
                form.addRow(t("Gyro spiegeln", "Invert gyro"), row)
        paired = [self.combos[k] for k in ("trigger_mode_l", "trigger_mode_r", "gyro")]  # same width: sliders line up
        for c in paired:
            c.setFixedWidth(max(c.sizeHint().width() for c in paired))
        self.color = QPushButton()
        self.color.clicked.connect(self.pick_color)
        battery_color = QPushButton(t("Akkustand", "Battery level"))
        battery_color.setToolTip(t("Grün bei vollem Akku, über Gelb (50 %) bis Rot bei leerem Akku", "Green when full, through yellow (50 %) to red when empty"))
        battery_color.clicked.connect(lambda: self.set("color", "battery"))
        game_color = QPushButton(t("Vom Spiel", "From game"))
        game_color.clicked.connect(lambda: self.set("color", ""))
        row = QHBoxLayout()
        row.addWidget(self.color)
        row.addWidget(battery_color)
        row.addWidget(game_color)
        form.addRow(t("Lichtleiste", "Light bar"), row)
        self.touchpad = QCheckBox(t("Touchpads als Maus am Desktop (alle Controller)", "Touchpads as desktop mouse (all controllers)"))
        self.touchpad.toggled.connect(self.app.set_touchpad)
        form.addRow(self.touchpad)
        self.bridge = QCheckBox(BRIDGE_LABEL)
        self.bridge.setToolTip(BRIDGE_TIP)
        self.bridge.toggled.connect(self.app.set_bridge)
        form.addRow(self.bridge)
        self.disconnect = QPushButton(t("Controller trennen", "Disconnect controller"))
        self.disconnect.clicked.connect(lambda: self.app.disconnect(self.mac()))
        reset = QPushButton(t("Zurücksetzen", "Reset"))
        reset.setToolTip(t("Alles auf Standard: Lautsprecher 50 %, übrige Regler 100 %, Trigger/Farbe/ID vom Spiel, Gyro aus, Auto-Trennen 15 min",
                           "Everything to default: speaker 50 %, other sliders 100 %, triggers/colour/ID from game, gyro off, auto-disconnect 15 min"))
        reset.clicked.connect(lambda: self.app.reset(self.mac()))
        row = QHBoxLayout()
        row.addWidget(reset)
        row.addWidget(self.disconnect)
        form.addRow(row)

    def mac(self):
        return self.target.currentData() or DEFAULT_KEY

    def set(self, key, value, slider=None):
        self.app.set(self.mac(), key, value)
        if key in PREVIEW and slider is not None and not slider.isSliderDown():
            self.app.preview_soon(key, 1200)  # groove click, wheel, arrow keys: wait until the user stops

    def pick_color(self):
        c = QColorDialog.getColor(QColor(self.app.settings(self.mac())["color"].replace("battery", "") or "#0050ff"), self,
                                  t("Farbe der Lichtleiste", "Light bar colour"))
        if c.isValid():
            self.set("color", c.name())

    def update_labels(self):
        """Battery/charging in the controller list without touching the selection."""
        for p in self.app.pads:
            i = self.target.findData(p["mac"])
            if i >= 0:
                self.target.setItemText(i, pad_label(p))

    def refresh_targets(self):
        current = self.mac()
        self.target.clear()
        for p in self.app.pads:
            self.target.addItem(pad_label(p), p["mac"])
        self.target.addItem(t("Standard für neue Controller", "Default for new controllers"), DEFAULT_KEY)
        self.target.setCurrentIndex(max(0, self.target.findData(current)))

    def refresh(self):
        cfg = self.app.settings(self.mac())
        for key, (slider, value) in self.sliders.items():
            slider.blockSignals(True)
            slider.setValue(cfg[key])
            slider.blockSignals(False)
            value.setText(f"{cfg[key]} %")
        for key, combo in self.combos.items():
            combo.setCurrentIndex(max(0, combo.findData(cfg[key])))
        for key, check in self.checks.items():
            check.blockSignals(True)
            check.setChecked(cfg[key])
            check.blockSignals(False)
        own = cfg["color"].startswith("#")
        self.color.setText(cfg["color"] if own else t("Akkustand", "Battery level") if cfg["color"] == "battery" else t("Farbe wählen …", "Choose colour …"))
        self.disconnect.setEnabled(bool(self.mac()))
        self.color.setStyleSheet(f"background: {cfg['color']}" if own else "")
        self.touchpad.blockSignals(True)
        self.touchpad.setChecked(self.app.data.get("touchpad_mouse", False))
        self.touchpad.blockSignals(False)
        self.bridge.blockSignals(True)
        self.bridge.setChecked(self.app.data.get("bridge", True))
        self.bridge.blockSignals(False)


class Tray(QApplication):
    def __init__(self):
        super().__init__(sys.argv)
        self.setQuitOnLastWindowClosed(False)
        self.data = load(CONFIG, {})
        if "default" not in self.data:  # first version wrote one flat settings dict
            flat = {k: v for k, v in self.data.items() if k in DEFAULTS}
            self.data = {"default": flat, "pads": {}, "touchpad_mouse": self.data.get("touchpad_mouse", False)}
        for section in [self.data["default"], *self.data["pads"].values()]:  # keys of the single-trigger version
            section.pop("trigger_mode", None)
            section.pop("trigger_strength", None)
        self.pads = []
        self.icon = QIcon.fromTheme("input-gamepad")
        self.tray = QSystemTrayIcon(self.icon)
        self.window = None
        self.save_timer = QTimer(singleShot=True, interval=150, timeout=self.save)  # coalesce slider drags
        self.preview_kind = None
        self.preview_timer = QTimer(singleShot=True, timeout=self.preview)
        self.menu = QMenu()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(lambda reason: reason == QSystemTrayIcon.Trigger and self.show_settings())
        self.tray.show()
        self.status_timer = QTimer(interval=5000, timeout=self.update_status)
        self.status_timer.start()
        self.update_status()
        self.save()  # writes the migrated format for the bridge

    def settings(self, mac):
        own = self.data["pads"].get(mac, {}) if mac else {}
        return {**DEFAULTS, **self.data["default"], **own}

    def set(self, mac, key, value):
        if mac:
            self.data["pads"].setdefault(mac, {})[key] = value
        else:
            self.data["default"][key] = value
        self.save_timer.start()
        self.build_menu()
        if self.window:
            self.window.refresh()

    def preview_soon(self, kind, delay):
        self.preview_kind = kind
        self.preview_timer.start(delay)  # restarts on every change; > save delay so the new value is used

    def preview(self):
        """Ask the bridge for a sample of the setting that was just changed (it reads the config file)."""
        self.data["preview"] = {"mac": self.window.mac() if self.window else "", "kind": self.preview_kind,
                                "n": time.time()}  # unique across DS5Tee restarts
        self.save()

    def reset(self, mac):
        if mac:
            self.data["pads"][mac] = dict(DEFAULTS)
        else:
            self.data["default"] = dict(DEFAULTS)
        self.save_timer.start()
        self.build_menu()
        if self.window:
            self.window.refresh()

    def disconnect(self, mac):
        subprocess.run(["bluetoothctl", "disconnect", mac], capture_output=True)

    def set_bridge(self, on):
        self.data["bridge"] = on
        self.save_timer.start()
        self.build_menu()

    def set_touchpad(self, on):
        self.data["touchpad_mouse"] = on
        self.save_timer.start()
        set_touchpad_mouse(on)
        self.build_menu()

    def save(self):
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".tmp", "w") as f:
            json.dump(self.data, f, indent=1)
        os.replace(CONFIG + ".tmp", CONFIG)

    def build_menu(self):
        """Per connected pad a submenu with trigger mode and player ID."""
        self.menu.clear()
        self.menu.addAction(t("Einstellungen …", "Settings …"), self.show_settings)
        self.menu.addSeparator()
        if not self.pads:
            self.menu.addAction(t("Kein DualSense verbunden", "No DualSense connected")).setEnabled(False)
        for p in self.pads:
            sub = self.menu.addMenu(pad_label(p))
            cfg = self.settings(p["mac"])
            for title, choices, keys in ((t("Trigger-Modus (L + R)", "Trigger mode (L + R)"), MODES, ("trigger_mode_l", "trigger_mode_r")),
                                         ("Controller-ID", PLAYERS, ("player",))):
                choice = sub.addMenu(title)
                group = QActionGroup(choice)
                for value, label in choices.items():
                    a = QAction(label, choice, checkable=True, checked=all(cfg[k] == value for k in keys))
                    a.triggered.connect(lambda _=False, m=p["mac"], ks=keys, v=value: [self.set(m, k, v) for k in ks])
                    group.addAction(a)
                    choice.addAction(a)
            sub.addAction(t("Trennen", "Disconnect"), lambda m=p["mac"]: self.disconnect(m))
        self.menu.addSeparator()
        touch = self.menu.addAction(t("Touchpads als Maus", "Touchpads as mouse"))
        touch.setCheckable(True)
        touch.setChecked(self.data.get("touchpad_mouse", False))
        touch.toggled.connect(self.set_touchpad)
        bridge = self.menu.addAction(BRIDGE_LABEL)
        bridge.setCheckable(True)
        bridge.setChecked(self.data.get("bridge", True))
        bridge.toggled.connect(self.set_bridge)
        self.menu.addAction(t("Beenden", "Quit"), self.quit)

    def update_status(self):
        set_touchpad_mouse(self.data.get("touchpad_mouse", False))  # also catches pads that reconnected
        self.pads = load(STATUS, {}).get("pads", [])
        self.tray.setToolTip("\n".join(pad_label(p) for p in self.pads) or (
            t("Kein DualSense verbunden", "No DualSense connected") if self.data.get("bridge", True)
            else t("Kabel-Emulation aus", "Wired emulation off")))
        if self.pads:
            keep_haptics_on_pad()
        if not self.menu.isVisible():  # labels carry the battery level; don't rebuild under the cursor
            self.build_menu()
        if self.window:
            if [self.window.target.itemData(i) for i in range(self.window.target.count() - 1)] != \
                    [p["mac"] for p in self.pads]:
                self.window.refresh_targets()
                self.window.refresh()
            self.window.update_labels()

    def show_settings(self):
        if not self.window:
            self.window = Settings(self)
        self.window.refresh_targets()
        self.window.refresh()
        self.window.show()
        self.window.raise_()
        self.window.activateWindow()


if __name__ == "__main__":
    sys.exit(Tray().exec())
